# Copie este arquivo para ".env" e preencha. NUNCA publique o .env no GitHub.

NODE_ENV=production
PORT=3000
# Endereço público do site, com https
BASE_URL=https://www.seudominio.com.br

# Segredo das sessões: gere com  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Mercado Pago > Suas integrações > sua aplicação > Credenciais de produção > Access Token
MP_ACCESS_TOKEN=
# Mercado Pago > Suas integrações > sua aplicação > Webhooks > "Assinatura secreta"
MP_WEBHOOK_SECRET=

# Frete fixo (centavos) e valor mínimo para frete grátis (centavos)
SHIPPING_CENTS=2500
FREE_SHIPPING_FROM_CENTS=30000
# Minutos até um pedido não pago expirar e devolver o estoque
PENDING_ORDER_TTL_MINUTES=60

# Banco de dados (SQLite). Em hospedagens com disco temporário, aponte para um volume persistente.
DB_PATH=./data/loja.db

# Só para testar no seu computador sem Mercado Pago (ignorado em produção):
# NODE_ENV=development
# PAYMENT_MODE=demo
